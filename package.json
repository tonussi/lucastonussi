{
  "name": "lucastonussi",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build && cp robots.txt build/client/robots.txt",
    "build:prod": "yarn install && react-router build --mode production && cp robots.txt build/client/robots.txt && cp build/client/index.html build/client/404.html",
